# DEMO_ONLY=true menggunakan dataset sintetis; belum terhubung ke database.
DEMO_ONLY=true
DATABASE_URL=mysql+pymysql://procureguard:CHANGE_ME@localhost:3306/procureguard
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME
# Tidak ada email yang dikirim secara otomatis.
EMAIL_SEND_ENABLED=false
# Untuk integrasi LLM tahap selanjutnya; simpan kredensial di environment, jangan commit .env.
LLM_PROVIDER=
LLM_API_KEY=
